<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- v132: 通话保活前台服务 —— 息屏后进程/网络不被系统掐断。
             类型必须是 microphone|mediaPlayback（targetSdk 34 不声明就起不来） -->
        <service
            android:name=".CallKeepService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- v113: MediaStore 写入相册在 Android 9 及以下需要此权限；Android 10+ 走分区存储无需它，
         故用 maxSdkVersion 限制，避免在新系统上申请（也不会影响新版权限模型） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- v132: 通话保活。前台服务让进程在息屏后仍被当作"正在为用户工作"，
         Android 14（targetSdk 34）要求按类型单独声明权限，缺则启动即崩 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- v125: 语音通话（真实时双向语音）所需权限
         RECORD_AUDIO 是 getUserMedia 在 WebView 里工作的【硬前提】：
           WebView 的 WebChromeClient.onPermissionRequest 只能"批准"网页请求，
           真正决定麦克风能不能打开的是 App 的运行时权限。
         没有这一行时：onPermissionRequest 里 requestPermissions 直接判定为拒绝，
           getUserMedia 报 NotAllowedError，语音通话完全不可用。
         MODIFY_AUDIO_SETTINGS：WebView / WebRTC 采集链需要的音频路由配置权限（install-time，无弹窗）。
         uses-feature microphone required=false：避免在无麦克风设备上被商店/安装器过滤掉。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
